# Copia este archivo a `.env.local` y completa los valores.

# Supabase (necesario para el login de administrador, el catálogo y las fotos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chat del asistente
GOOGLE_GENERATIVE_AI_API_KEY=

# Shopify (opcional: catálogo de Shopify; si se deja vacío se usa el catálogo de Supabase)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Auth0 (Para inicio de sesión de usuarios con Gmail / Google)
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
